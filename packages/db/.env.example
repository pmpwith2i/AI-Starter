# Prisma reads this file (via `dotenv/config` in prisma.config.ts) from the
# packages/db directory — so DATABASE_URL must live HERE, not only in
# apps/server/.env. `personalize.sh` copies this to packages/db/.env and keeps
# it in sync with apps/server/.env.
#
# Matches docker-compose.yml: port 5435, user/pass admin, db "starter".
DATABASE_URL=postgresql://admin:admin@localhost:5435/starter?schema=public
