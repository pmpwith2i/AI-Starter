// Starter schema — stripped of every domain.
// Models retained: User + RefreshToken + ConsentRecord + AuditLog + Notification.
// Add domain models per the type-cascade workflow described in AGENT.md.
//
// All columns use snake_case via @map(). Sensitive free-text columns are stored
// as `String` ciphertext encrypted via @repo/crypto in the service layer.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Identity
// =====================================================
model User {
  id                            String    @id @default(cuid())
  email                         String    @unique
  passwordHash                  String    @map("password_hash")
  firstName                     String?   @map("first_name")
  lastName                      String?   @map("last_name")
  emailVerified                 Boolean   @default(false) @map("email_verified")
  emailVerificationCode         String?   @map("email_verification_code")
  emailVerificationExpires      DateTime? @map("email_verification_expires")
  emailVerificationAttempts     Int       @default(0) @map("email_verification_attempts")
  passwordResetCode             String?   @map("password_reset_code")
  passwordResetExpires          DateTime? @map("password_reset_expires")
  passwordResetAttempts         Int       @default(0) @map("password_reset_attempts")
  failedLoginAttempts           Int       @default(0) @map("failed_login_attempts")
  lockedUntil                   DateTime? @map("locked_until")
  lastFailedLoginAt             DateTime? @map("last_failed_login_at")
  tokenVersion                  Int       @default(0) @map("token_version")
  deletedAt                     DateTime? @map("deleted_at")
  retentionExpiresAt            DateTime? @map("retention_expires_at")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  consents       ConsentRecord[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// =====================================================
// GDPR — Consent (append-only on revoke; DELETE revoked)
// =====================================================
enum ConsentPurpose {
  terms_of_service
  privacy_policy
  health_data_processing
  ai_data_processing
  marketing_communications
  third_party_payments
}

model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  purpose       ConsentPurpose
  policyVersion String         @map("policy_version")
  grantedAt     DateTime?      @map("granted_at")
  withdrawnAt   DateTime?      @map("withdrawn_at")
  ipAddressHash String?        @map("ip_address_hash")
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("consent_records")
}

// =====================================================
// GDPR — Audit Log (append-only, REVOKE UPDATE/DELETE)
// =====================================================
enum ActorType {
  user
  admin
  system
}

enum AuditAction {
  read
  create
  update
  delete
  export
}

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?     @map("actor_id")
  actorType     ActorType   @map("actor_type")
  targetId      String?     @map("target_id")
  targetModel   String?     @map("target_model")
  action        AuditAction
  fields        String[]
  reason        String?
  ipAddressHash String?     @map("ip_address_hash")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetId, targetModel])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================
// Realtime — example surface (Notification)
// Drives the dashboard's realtime invalidation pattern.
// Drop this if you don't want a starter notification surface.
// =====================================================
model Notification {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  type               String
  title              String
  body               String?
  readAt             DateTime? @map("read_at")
  retentionExpiresAt DateTime? @map("retention_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
