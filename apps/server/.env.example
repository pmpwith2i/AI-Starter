NODE_ENV=development
SERVER_PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://admin:admin@localhost:5432/starter?schema=public
LOG_LEVEL=debug

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRY=30m
REFRESH_TOKEN_EXPIRY_SECONDS=604800

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Optional: separate pg connection URL for LISTEN/NOTIFY (no Prisma params). Falls back to DATABASE_URL.
# PG_LISTEN_URL=postgresql://admin:admin@localhost:5432/starter

# Resend API key for transactional emails (verification, password reset). Required.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@example.com

# GDPR — bump version to force re-consent.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-key-00000000000000000000000
PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
