{
  "name": "@repo/server",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env --conditions=development --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -b",
    "lint": "eslint --max-warnings 0",
    "test": "node --env-file=.env.test --import=tsx/esm --experimental-test-module-mocks --conditions=development --test $(find src -type f -name '*.test.ts')"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@repo/ai": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/server-sdk": "workspace:*",
    "close-with-grace": "^2.5.0",
    "env-schema": "^7.0.0",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "json-schema-to-ts": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.14",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
