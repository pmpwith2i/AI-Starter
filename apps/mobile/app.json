{
  "expo": {
    "name": "Starter",
    "slug": "starter-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "starter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starter.app"
    },
    "android": {
      "package": "com.starter.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
